{ "page": "gates", "desc": "旧2D版の gates の保存 {stage, coins, best, up} が v2 に移行され、到達ステージが下がらない（gates の migrate()）",
  "storage": { "kusoge.gates.save": { "stage": 7, "coins": 120, "best": 6, "up": { "men": 3, "rate": 2 } } },
  "expect": [
    { "key": "kusoge.gates.save", "path": "v", "eq": 2 },
    { "key": "kusoge.gates.save", "path": "best", "min": 6 },
    { "key": "kusoge.gates.save", "path": "coins", "min": 120 },
    { "key": "kusoge.gates.save", "path": "mat", "min": 6 } ] }
