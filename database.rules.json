{
  "rules": {
    ".read": false,
    ".write": false,
    "hole": {
      "queue": {
        ".read": "auth != null",
        "$uid": { ".write": "auth != null && auth.uid === $uid" }
      },
      "rooms": {
        "$room": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    },
    "vs": {
      "queue": {
        "$game": {
          ".read": "auth != null",
          "$uid": { ".write": "auth != null && auth.uid === $uid" }
        }
      },
      "rooms": {
        "$room": {
          ".read": "auth != null",
          ".write": "auth != null"
        }
      }
    }
  }
}
